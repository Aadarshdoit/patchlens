# PatchLens backend environment configuration
# Copy this file to .env and fill in real values.
# Never commit .env or any file containing a real API key.

# Groq API key — obtain from https://console.groq.com/
GROQ_API_KEY=

# Groq model to use for AI diff analysis
GROQ_MODEL=openai/gpt-oss-120b

# Allowed CORS origins for the frontend (comma-separated).
# Development default: http://localhost:3000
# Production example: https://patchlens.example.com
ALLOWED_ORIGINS=http://localhost:3000

# Optional: override the project root used for path validation.
# Defaults to the repository root (two levels above backend/).
# PATCHLENS_PROJECT_ROOT=/path/to/patchlens
